generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================================================
// AUTH (Auth.js / NextAuth v5 + Prisma Adapter)
// ==========================================================================

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // hashed with bcrypt; null for OAuth-only accounts
  phone         String?
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)

  // Loyalty
  points          Int       @default(0)
  tier            String    @default("Bronze")
  ordersCompleted Int       @default(0)
  birthday        DateTime?

  // Staff-only fields
  position String?

  accounts Account[]
  sessions Session[]

  orders              Order[]
  walkInOrdersCreated Order[]               @relation("OrdersCreatedByStaff")
  rewardRedemptions   RewardRedemption[]
  pointsHistory       PointsHistory[]
  contactMessages     ContactMessage[]
  activityLogs        ActivityLog[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ==========================================================================
// MENU
// ==========================================================================

enum MenuCategoryName {
  COFFEE
  ICED_COFFEE
  NON_COFFEE
  FRAPPES
  PASTRIES
  DESSERTS
}

enum ProductTag {
  NEW
  BEST_SELLER
  SOLD_OUT
}

model Category {
  id        String           @id @default(cuid())
  name      MenuCategoryName @unique
  label     String
  sortOrder Int              @default(0)
  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  ingredients String[]
  basePrice   Int // whole PHP
  image       String?
  tag         ProductTag?
  isAvailable Boolean     @default(true)
  isFeatured  Boolean     @default(false)
  sortOrder   Int         @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([tag])
}

// ==========================================================================
// ORDERS (QR self-pickup ordering)
// ==========================================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderSource {
  QR
  WALK_IN
}

enum SizeOption {
  SMALL
  MEDIUM
  LARGE
}

enum SweetnessOption {
  ORIGINAL
  LESS_SWEET
  SWEETER
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)
  source      OrderSource @default(QR)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  guestName  String?
  guestEmail String?

  // Set only for WALK_IN orders — which staff member rang it up.
  createdByStaffId String?
  createdByStaff    User?   @relation("OrdersCreatedByStaff", fields: [createdByStaffId], references: [id])

  items OrderItem[]

  subtotal Int
  total    Int

  qrToken     String    @unique @default(cuid())
  scannedAt   DateTime?
  confirmedAt DateTime?
  preparingAt DateTime?
  readyAt     DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  pointsAwarded Int @default(0)

  pointsHistoryEntries PointsHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([source])
  @@index([createdByStaffId])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  productName  String // snapshot at time of order
  size         SizeOption
  sweetness    SweetnessOption
  instructions String?
  quantity     Int
  unitPrice    Int

  @@index([orderId])
  @@index([productId])
}

// ==========================================================================
// LOYALTY / REWARDS
// ==========================================================================

enum RewardCategoryName {
  COFFEE
  NON_COFFEE
  PASTRIES
  DESSERTS
  MERCHANDISE
  LIMITED_EDITION
}

enum RedemptionStatus {
  PENDING
  REDEEMED
  EXPIRED
  CANCELLED
}

model Reward {
  id          String             @id @default(cuid())
  name        String
  description String
  points      Int
  category    RewardCategoryName
  image       String?
  isAvailable Boolean            @default(true)
  sortOrder   Int                @default(0)

  redemptions RewardRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model RewardRedemption {
  id       String           @id @default(cuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id])
  rewardId String
  reward   Reward           @relation(fields: [rewardId], references: [id])
  points   Int
  status   RedemptionStatus @default(PENDING)

  qrToken    String    @unique @default(cuid())
  expiresAt  DateTime
  approvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model PointsHistory {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id])
  pointsEarned   Int      @default(0)
  rewardRedeemed String?
  runningTotal   Int
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([orderId])
}

// ==========================================================================
// WEBSITE CONTENT
// ==========================================================================

model Promotion {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  review    String
  image     String?
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
}

model Gallery {
  id        String   @id @default(cuid())
  image     String
  caption   String?
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Settings {
  id             String  @id @default("singleton")
  siteName       String  @default("HOLA Coffee")
  logoUrl        String?
  primaryColor   String  @default("#5AA9E6")
  secondaryColor String  @default("#F8DC6B")

  address      String?
  phone        String?
  email        String?
  mapsUrl      String?
  facebookUrl  String?
  instagramUrl String?

  hoursWeekday String?
  hoursWeekend String?

  pointsPerOrder      Int   @default(15)
  birthdayBonusPoints Int   @default(100)
  pointsMultiplier    Float @default(1.0)

  seoTitle       String?
  seoDescription String?

  homepageVideoUrl  String?
  homepageVideoType String?

  updatedAt DateTime @updatedAt
}

// ==========================================================================
// SUPPORT / OPS
// ==========================================================================

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id       String        @id @default(cuid())
  fullName String
  email    String
  phone    String?
  subject  String
  message  String
  status   MessageStatus @default(UNREAD)

  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([status])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // e.g. "Admin created Menu Item"
  entity    String? // e.g. "Product", "Order"
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
